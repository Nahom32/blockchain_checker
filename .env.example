# Copy this file to .env and set your RPC endpoint(s).

# Single node, used by integrity_checker.js and tamper_checker.js.
# Defaults to http://localhost:8545 (the local Hardhat node: `npm run node`).
WEB3_PROVIDER_URL=http://localhost:8545

# Several nodes to compare against each other (comma-separated), used by
# compare_providers.js. Falls back to WEB3_PROVIDER_URL when unset.
# Reports show only each provider's host, never API keys in the URL.
# WEB3_PROVIDER_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
